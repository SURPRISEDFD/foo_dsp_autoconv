#include <windows.h>
#include "resource.h"

IDD_CONFIG DIALOGEX 0, 0, 300, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Auto Calibration Convolver"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Enable processing", IDC_ENABLED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 7, 8, 280, 10

    LTEXT           "Calibration folder (scanned including all subfolders):", IDC_STATIC, 7, 26, 240, 8
    EDITTEXT        IDC_FOLDER, 7, 36, 258, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE, 269, 36, 24, 13

    CONTROL         "Auto level match (normalize combined impulse response to unity RMS gain)",
                    IDC_AUTOGAIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 56, 286, 10

    LTEXT           "Additional gain (dB):", IDC_STATIC, 7, 76, 80, 8
    EDITTEXT        IDC_GAIN, 92, 74, 50, 13, ES_AUTOHSCROLL

    CONTROL         "Adaptive FFT size (follows IR length; power-of-2 blocks only)",
                    IDC_ADAPTIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 94, 286, 10

    LTEXT           "Every *.wav under the folder whose file name contains the current sample rate (e.g. 96000) is loaded and convolved in series. Skipped files are explained in the foobar2000 Console; audio passes through untouched when nothing usable matches.",
                    IDC_STATIC, 7, 112, 286, 26

    DEFPUSHBUTTON   "OK", IDOK, 186, 146, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 146, 50, 14
END
